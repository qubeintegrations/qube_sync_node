{
  "name": "qubesync",
  "version": "0.2.0",
  "description": "The QuBe Sync v2 API client, and webhook verification and parsing (QuickBooks Desktop through qubesync.com).",
  "license": "MIT",
  "author": "QuBe Sync",
  "homepage": "https://docs.qubesync.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qubeintegrations/qube_sync_node.git"
  },
  "bugs": "https://github.com/qubeintegrations/qube_sync_node/issues",
  "keywords": [
    "qubesync",
    "quickbooks",
    "quickbooks-desktop",
    "api-client",
    "webhooks",
    "hmac"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./operations/*": {
      "types": "./operations/*.d.ts",
      "default": "./operations/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "operations/",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.17"
  },
  "scripts": {
    "test": "node --test test/webhooks.test.js test/client.test.js test/esm.test.mjs",
    "test:types": "npx -y -p typescript@5.6.3 tsc --noEmit --strict --module node16 --moduleResolution node16 --target es2020 test/types.ts",
    "generate": "node scripts/generate-operations.js",
    "generate:check": "node scripts/generate-operations.js --check"
  }
}
