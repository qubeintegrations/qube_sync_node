{
  "name": "qubesync",
  "version": "0.3.0",
  "description": "The QuBe Sync v2 API client, webhook verification and parsing, and the integration kit (qubesync/kit, qubesync/express): QuickBooks Desktop through qubesync.com.",
  "license": "MIT",
  "author": "QuBe Sync",
  "homepage": "https://docs.qubesync.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qubeintegrations/qube_sync_node.git"
  },
  "bugs": "https://github.com/qubeintegrations/qube_sync_node/issues",
  "keywords": [
    "qubesync",
    "quickbooks",
    "quickbooks-desktop",
    "api-client",
    "webhooks",
    "hmac",
    "express"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./kit": {
      "types": "./kit/index.d.ts",
      "import": "./kit/index.mjs",
      "require": "./kit/index.js"
    },
    "./kit/store-tests": {
      "types": "./kit/store-tests.d.ts",
      "import": "./kit/store-tests.mjs",
      "require": "./kit/store-tests.js"
    },
    "./kit/schema.sql": "./kit/schema.sql",
    "./express": {
      "types": "./express/index.d.ts",
      "import": "./express/index.mjs",
      "require": "./express/index.js"
    },
    "./operations/*": {
      "types": "./operations/*.d.ts",
      "default": "./operations/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "operations/",
    "kit/",
    "express/",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.17"
  },
  "scripts": {
    "test": "node --test test/webhooks.test.js test/client.test.js test/esm.test.mjs test/kit.test.js test/store.test.js test/express.test.js test/kit-esm.test.mjs",
    "test:types": "tsc --noEmit --strict --module node16 --moduleResolution node16 --target es2020 test/types.ts test/kit-types.ts",
    "generate": "node scripts/generate-operations.js",
    "generate:check": "node scripts/generate-operations.js --check"
  },
  "peerDependencies": {
    "express": ">=4.17 <6"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "express": "4.21.2",
    "typescript": "5.6.3"
  }
}
